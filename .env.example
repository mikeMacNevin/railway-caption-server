# Copy to .env for local dev, or set these in Railway's server service
# environment variables for production.

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_PORT=3306

# Shared secret for GET /api/debug. The route is disabled outright (404)
# whenever this isn't set, so it's safe to leave blank - but that also
# means /api/debug won't work anywhere until you set it, local or prod.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
DEBUG_KEY=
